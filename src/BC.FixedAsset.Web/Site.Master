<%@ Master Language="C#" AutoEventWireup="true" CodeBehind="Site.Master.cs" Inherits="BC.FixedAsset.Web.SiteMaster" %>
<!doctype html><html lang="th"><head runat="server"><meta charset="utf-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/><title><%: Page.Title %> | BC Enterprise Applications</title><link rel="icon" href="<%= ResolveUrl("~/favicon.ico") %>"/><link rel="stylesheet" href="<%= ResolveUrl("~/Content/site.css") %>"/><asp:ContentPlaceHolder ID="HeadContent" runat="server"/></head><body><form id="form1" runat="server" enctype="multipart/form-data">
<div class="app-shell"><aside class="sidebar" id="sidebar"><a class="brand-button" href="<%= ResolveUrl("~/Portal/Default.aspx") %>"><img src="<%= ResolveUrl("~/Assets/better-code-logo.png") %>" alt="Better Code"/><span>Enterprise Applications</span></a><div class="current-app"><small>แอปพลิเคชันปัจจุบัน</small><b><asp:Literal ID="litApplicationName" runat="server"/></b></div>
<nav><a class="nav-item" href="<%= ResolveUrl("~/Portal/Default.aspx") %>"><svg viewBox="0 0 24 24"><rect x="3" y="3" width="7" height="7"/><rect x="14" y="3" width="7" height="7"/><rect x="3" y="14" width="7" height="7"/><rect x="14" y="14" width="7" height="7"/></svg><span>Application Portal</span></a>
<asp:PlaceHolder ID="phFixedAssetNavigation" runat="server"><a class="nav-item" href="<%= ResolveUrl("~/FixedAsset/Dashboard.aspx") %>"><svg viewBox="0 0 24 24"><path d="M4 19V9M10 19V5M16 19v-8M22 19H2"/></svg><span>ภาพรวม / Dashboard</span></a><a class="nav-item" href="<%= ResolveUrl("~/FixedAsset/Survey/List.aspx") %>"><svg viewBox="0 0 24 24"><circle cx="11" cy="11" r="7"/><path d="m20 20-4-4M8 11h6M11 8v6"/></svg><span>สำรวจทรัพย์สิน / Survey</span></a><a class="nav-item" href="<%= ResolveUrl("~/FixedAsset/Review/Manager.aspx") %>"><svg viewBox="0 0 24 24"><path d="M9 11l3 3L22 4M21 12v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11"/></svg><span>ผู้จัดการทรัพย์สิน</span></a><a class="nav-item" href="<%= ResolveUrl("~/FixedAsset/Review/Finance.aspx") %>"><svg viewBox="0 0 24 24"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10"/><path d="m9 12 2 2 4-4"/></svg><span>ฝ่ายการเงิน / Finance</span></a><a class="nav-item" href="<%= ResolveUrl("~/FixedAsset/Register/List.aspx") %>"><svg viewBox="0 0 24 24"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><path d="M14 2v6h6M8 13h8M8 17h8"/></svg><span>ทะเบียนทรัพย์สิน</span></a><a class="nav-item" href="<%= ResolveUrl("~/FixedAsset/Reports.aspx") %>"><svg viewBox="0 0 24 24"><path d="M3 3v18h18M7 16v-5M12 16V7M17 16v-3"/></svg><span>รายงาน / Reports</span></a></asp:PlaceHolder>
<asp:PlaceHolder ID="phAdminNavigation" runat="server"><div class="nav-label">ADMINISTRATION</div><a class="nav-item" href="<%= ResolveUrl("~/Admin/Dashboard.aspx") %>"><svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="3"/><path d="M19 15l2 2-4 4-2-2M9 4L7 2 3 6l2 2M3 14H1v4h2M14 3V1h-4v2"/></svg><span>ข้อมูลและบริหารระบบ</span></a></asp:PlaceHolder>
<div class="nav-label">ACCOUNT</div><a class="nav-item" href="<%= ResolveUrl("~/Account/Profile.aspx") %>"><svg viewBox="0 0 24 24"><circle cx="12" cy="8" r="4"/><path d="M4 21a8 8 0 0 1 16 0"/></svg><span>ข้อมูลส่วนตัว / My Profile</span></a></nav><div class="environment"><i></i><asp:Literal ID="litEnvironment" runat="server"/> SITE</div></aside>
<main class="main-panel"><header class="topbar"><button class="mobile-menu icon-button" type="button" data-menu aria-label="Menu">☰</button><div class="page-context"><small>BC ENTERPRISE</small><strong><asp:Literal ID="litBreadcrumb" runat="server"/></strong></div><div class="top-actions"><button type="button" class="button outline compact" id="languageButton">◎ <span>EN</span></button><a class="profile-chip" href="<%= ResolveUrl("~/Account/Profile.aspx") %>"><span><asp:Literal ID="litUserInitials" runat="server"/></span><div><b><asp:Literal ID="litUserName" runat="server"/></b><small><asp:Literal ID="litUserDepartment" runat="server"/></small></div></a><asp:LinkButton ID="btnLogout" runat="server" CssClass="logout-icon" OnClick="Logout_Click" ToolTip="Sign out">↪</asp:LinkButton></div></header><section class="workspace"><asp:ContentPlaceHolder ID="MainContent" runat="server"/></section></main></div>
<div id="loadingOverlay" class="loading-overlay"><div class="loading-dialog"><div class="processing-visual"><span>FA</span><i></i></div><b>ระบบกำลังประมวลผล กรุณารอสักครู่…</b><small>BC Fixed Asset</small></div></div></form><script src="<%= ResolveUrl("~/Scripts/site.js") %>"></script><asp:ContentPlaceHolder ID="ScriptContent" runat="server"/></body></html>
