<%@ Page Title="Fixed Asset Numbering" Language="C#" MasterPageFile="~/Site.Master" AutoEventWireup="true" CodeBehind="Numbering.aspx.cs" Inherits="BC.FixedAsset.Web.FixedAsset.Numbering" %>
<asp:Content ID="Body" ContentPlaceHolderID="MainContent" runat="server"><div class="admin-tabs"><a href="../Admin/Applications.aspx">▣ Application Portal</a><a href="../Admin/Users.aspx">♙ ผู้ใช้และสิทธิ์</a><a href="../Admin/MasterData.aspx">▤ ข้อมูลกลาง</a><a class="active" href="Numbering.aspx">⚙ เลขทรัพย์สิน</a></div><div class="page-head"><div><h1>Fixed Asset Numbering</h1><p>กำหนด Pattern, Running Scope และ Reset Policy โดย Admin</p></div></div><section class="card"><div class="card-body form-grid"><asp:HiddenField ID="hidSchemeId" runat="server"/><div class="field full"><label>Pattern</label><asp:TextBox ID="txtPattern" runat="server" Text="{COMPANY}-{CATEGORY}-{YEAR}-{SEQ}"/><small>Tokens: {COMPANY}, {CATEGORY}, {YEAR}, {MONTH}, {SEQ}</small></div><div class="field"><label>Sequence Digits</label><asp:TextBox ID="txtDigits" runat="server" TextMode="Number" Text="4"/></div><div class="field"><label>Reset Policy</label><asp:DropDownList ID="ddlReset" runat="server"><asp:ListItem>Yearly</asp:ListItem><asp:ListItem>Monthly</asp:ListItem><asp:ListItem>Never</asp:ListItem></asp:DropDownList></div><div class="field"><label>Sequence Scope</label><asp:DropDownList ID="ddlScope" runat="server"><asp:ListItem>Company + Category + Year</asp:ListItem><asp:ListItem>Company + Year</asp:ListItem><asp:ListItem>Global</asp:ListItem></asp:DropDownList></div><div class="field"><label>Start Value</label><asp:TextBox ID="txtStart" runat="server" TextMode="Number" Text="1"/></div><div class="field full"><asp:Button ID="btnSave" runat="server" CssClass="button primary" Text="บันทึก Numbering Scheme" OnClick="Save_Click"/></div><asp:Label ID="lblMessage" runat="server"/></div></section></asp:Content>
