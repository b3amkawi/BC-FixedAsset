<%@ Page Title="Asset Survey" Language="C#" MasterPageFile="~/Site.Master" AutoEventWireup="true" CodeBehind="List.aspx.cs" Inherits="BC.FixedAsset.Web.FixedAsset.Survey.SurveyList" %>
<asp:Content ID="Body" ContentPlaceHolderID="MainContent" runat="server"><div class="page-head"><div><h1 data-th="สำรวจทรัพย์สิน" data-en="Asset Survey">สำรวจทรัพย์สิน</h1><p data-th="ค้นหาและติดตามสถานะรายการทรัพย์สิน" data-en="Search and track asset records">ค้นหาและติดตามสถานะรายการทรัพย์สิน</p></div><div class="page-actions"><asp:Button ID="btnExport" runat="server" Text="Export Excel" CssClass="button outline" OnClick="Export_Click"/><a class="button primary" href="Edit.aspx">＋ บันทึกสำรวจทรัพย์สิน</a></div></div><asp:Label ID="lblMessage" runat="server" CssClass="message"/>
<section class="card table-card"><div class="table-toolbar"><div class="search-box"><asp:TextBox ID="txtSearch" runat="server" placeholder="ค้นหาเลขสำรวจ ชื่อทรัพย์สิน Serial"/><asp:DropDownList ID="ddlStatus" runat="server"><asp:ListItem Value="">ทุกสถานะ</asp:ListItem><asp:ListItem>Draft</asp:ListItem><asp:ListItem>Returned</asp:ListItem><asp:ListItem>ManagerReview</asp:ListItem><asp:ListItem>FinanceReview</asp:ListItem><asp:ListItem>Registered</asp:ListItem></asp:DropDownList><asp:Button ID="btnSearch" runat="server" Text="ค้นหา" CssClass="button outline compact" OnClick="Search_Click"/></div><span class="badge">Asset records</span></div><div class="table-wrap"><asp:GridView ID="gridSurvey" runat="server" AutoGenerateColumns="false" GridLines="None" DataKeyNames="SurveyId" OnRowCommand="Grid_RowCommand" OnRowDataBound="Grid_RowDataBound" CssClass="asset-table survey-table"><Columns>
<asp:TemplateField HeaderText="รูปตัวอย่างขนาดเล็ก"><ItemTemplate><img class="asset-thumb" src='<%# AttachmentUrl(Eval("ActualAttachmentId")) %>' alt="asset"/><asp:LinkButton ID="btnDetail" runat="server" CssClass="row-detail-trigger" CommandName="Detail" CommandArgument='<%# Eval("SurveyId") %>' Text="ดูรายละเอียด"/></ItemTemplate></asp:TemplateField><asp:BoundField DataField="SurveyNo" HeaderText="เลขที่"/><asp:TemplateField HeaderText="ทรัพย์สิน"><ItemTemplate><b><%# Eval("AssetName") %></b><small class="cell-sub"><%# Eval("SerialNumber") %></small></ItemTemplate></asp:TemplateField><asp:TemplateField HeaderText="ขนาด"><ItemTemplate><%# Dimension(Eval("WidthCm"),Eval("LengthCm"),Eval("HeightCm")) %></ItemTemplate></asp:TemplateField><asp:BoundField DataField="WeightKg" HeaderText="น้ำหนัก"/><asp:TemplateField HeaderText="จำนวน"><ItemTemplate><%# Eval("Quantity") %> <%# Eval("UomCode") %></ItemTemplate></asp:TemplateField><asp:TemplateField HeaderText="สถานที่"><ItemTemplate><%# Eval("BuildingName") %> / <%# Eval("FloorName") %> / <%# Eval("RoomName") %></ItemTemplate></asp:TemplateField><asp:BoundField DataField="Custodian" HeaderText="ผู้รับผิดชอบ"/><asp:BoundField DataField="CreatedByName" HeaderText="ผู้สร้างรายงาน"/><asp:TemplateField HeaderText="สถานะ"><ItemTemplate><span class="status-pill" data-status='<%# Eval("Status") %>'><%# Eval("Status") %></span><small class="return-note"><%# Eval("ReturnReason") %></small></ItemTemplate></asp:TemplateField><asp:TemplateField><ItemTemplate><div class="survey-actions"><asp:HyperLink runat="server" CssClass="button small outline" NavigateUrl='<%# "Edit.aspx?id="+Eval("SurveyId") %>' Visible='<%# CanEdit(Eval("Status")) %>'>แก้ไข</asp:HyperLink><asp:LinkButton runat="server" CssClass="button small danger" Visible='<%# CanEdit(Eval("Status")) %>' CommandName="DeleteSurvey" CommandArgument='<%# Eval("SurveyId") %>' OnClientClick="return confirm('ยืนยันการลบรายการนี้?');">ลบ</asp:LinkButton></div></ItemTemplate></asp:TemplateField></Columns></asp:GridView></div></section>
<asp:Panel ID="pnlDetail" runat="server" CssClass="modal-layer" Visible="false"><div class="modal-card"><div class="modal-head"><div><h2>Asset Survey Detail</h2><p class="muted">รายละเอียดทรัพย์สินและสถานะ Workflow</p></div><asp:Button ID="btnClose" runat="server" Text="×" CssClass="icon-button" OnClick="Close_Click" CausesValidation="false"/></div><div class="detail-images"><asp:Repeater ID="repImages" runat="server"><ItemTemplate><figure><img src='<%# AttachmentUrl(Eval("AttachmentId")) %>'/><figcaption><%# Eval("AttachmentType") %></figcaption></figure></ItemTemplate></asp:Repeater></div><asp:Literal ID="litDetail" runat="server"/></div></asp:Panel></asp:Content>
