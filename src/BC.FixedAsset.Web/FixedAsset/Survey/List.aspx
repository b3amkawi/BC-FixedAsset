<%@ Page Title="Asset Survey" Language="C#" MasterPageFile="~/Site.Master" AutoEventWireup="true" CodeBehind="List.aspx.cs" Inherits="BC.FixedAsset.Web.FixedAsset.Survey.SurveyList" %>
<asp:Content ID="Body" ContentPlaceHolderID="MainContent" runat="server"><div class="page-head"><div><h1 data-th="สำรวจทรัพย์สิน" data-en="Asset Survey">สำรวจทรัพย์สิน</h1><p data-th="ค้นหาและติดตามสถานะรายการทรัพย์สิน" data-en="Search and track asset records">ค้นหาและติดตามสถานะรายการทรัพย์สิน</p></div><div class="page-actions"><button type="button" class="button outline" onclick="openImportDialog()">Import Excel</button><asp:Button ID="btnExport" runat="server" Text="Export Excel" CssClass="button outline" OnClick="Export_Click"/><a class="button primary" href="Edit.aspx">＋ บันทึกสำรวจทรัพย์สิน</a></div></div><asp:Label ID="lblMessage" runat="server" CssClass="message"/>
<section class="card table-card"><div class="table-toolbar"><div class="search-box survey-filter-box"><asp:TextBox ID="txtSearch" runat="server" placeholder="ค้นหาเลขสำรวจ ชื่อทรัพย์สิน Serial"/><asp:DropDownList ID="ddlStatus" runat="server"><asp:ListItem Value="">ทุกสถานะ</asp:ListItem><asp:ListItem>Draft</asp:ListItem><asp:ListItem>Returned</asp:ListItem><asp:ListItem>Rejected</asp:ListItem><asp:ListItem>ManagerReview</asp:ListItem><asp:ListItem>FinanceReview</asp:ListItem><asp:ListItem>Registered</asp:ListItem></asp:DropDownList><asp:DropDownList ID="ddlRoomFilter" runat="server"/><asp:DropDownList ID="ddlDepartmentFilter" runat="server"/><asp:DropDownList ID="ddlCustodianFilter" runat="server"/><asp:Button ID="btnSearch" runat="server" Text="ค้นหา" CssClass="button outline compact" OnClick="Search_Click"/></div></div><div class="table-wrap"><asp:GridView ID="gridSurvey" runat="server" AutoGenerateColumns="false" GridLines="None" DataKeyNames="SurveyId" AllowSorting="true" OnSorting="Grid_Sorting" OnRowCommand="Grid_RowCommand" OnRowDataBound="Grid_RowDataBound" CssClass="asset-table survey-table"><Columns>
<asp:TemplateField HeaderText="รูปภาพ"><ItemTemplate><img class="asset-thumb" loading="lazy" decoding="async" fetchpriority="low" src='<%# AttachmentUrl(Eval("ActualAttachmentId")) %>' alt="asset"/><asp:LinkButton ID="btnDetail" runat="server" CssClass="row-detail-trigger" CommandName="Detail" CommandArgument='<%# Eval("SurveyId") %>' Text="ดูรายละเอียด"/></ItemTemplate></asp:TemplateField><asp:BoundField DataField="SurveyNo" HeaderText="เลขที่" SortExpression="SurveyNo"/><asp:TemplateField HeaderText="ทรัพย์สิน" SortExpression="AssetName"><ItemTemplate><b><%# Eval("AssetName") %></b><small class="cell-sub"><%# Eval("SerialNumber") %></small></ItemTemplate></asp:TemplateField><asp:TemplateField HeaderText="ขนาด" SortExpression="Dimensions"><ItemTemplate><%# Dimension(Eval("WidthCm"),Eval("LengthCm"),Eval("HeightCm")) %></ItemTemplate></asp:TemplateField><asp:BoundField DataField="WeightKg" HeaderText="น้ำหนัก" SortExpression="WeightKg"/><asp:TemplateField HeaderText="จำนวน" SortExpression="Quantity"><ItemTemplate><%# Eval("Quantity") %> <%# Eval("UomCode") %></ItemTemplate></asp:TemplateField><asp:TemplateField HeaderText="สถานที่" SortExpression="Location"><ItemTemplate><%# Eval("BuildingName") %> / <%# Eval("FloorName") %> / <%# Eval("RoomName") %></ItemTemplate></asp:TemplateField><asp:BoundField DataField="Custodian" HeaderText="ผู้รับผิดชอบ" SortExpression="Custodian"/><asp:BoundField DataField="CreatedByName" HeaderText="ผู้สร้างรายงาน" SortExpression="CreatedByName"/><asp:TemplateField HeaderText="สถานะ"><ItemTemplate><span class="status-pill" data-status='<%# Eval("Status") %>'><%# Eval("Status") %></span><small class="return-note"><%# Eval("ReturnReason") %></small></ItemTemplate></asp:TemplateField><asp:TemplateField><ItemTemplate><div class="survey-actions"><asp:HyperLink runat="server" CssClass="button small outline" NavigateUrl='<%# "Edit.aspx?id="+Eval("SurveyId") %>' Visible='<%# CanEdit(Eval("Status")) %>'>แก้ไข</asp:HyperLink><asp:LinkButton runat="server" CssClass="button small danger" Visible='<%# CanEdit(Eval("Status")) %>' CommandName="DeleteSurvey" CommandArgument='<%# Eval("SurveyId") %>' OnClientClick="return confirm('ยืนยันการลบรายการนี้?');">ลบ</asp:LinkButton></div></ItemTemplate></asp:TemplateField></Columns></asp:GridView></div><div class="survey-pager"><asp:Button ID="btnPreviousPage" runat="server" Text="← ก่อนหน้า" CssClass="button outline compact" OnClick="PreviousPage_Click"/><div class="survey-page-summary"><asp:Label ID="lblPageInfo" runat="server" CssClass="survey-page-info"/><span>20 รายการต่อหน้า</span></div><asp:Button ID="btnNextPage" runat="server" Text="ถัดไป →" CssClass="button outline compact" OnClick="NextPage_Click"/></div></section>
<div id="importDialog" class="modal-layer" role="dialog" aria-modal="true" aria-labelledby="importTitle" hidden><div class="modal-card import-dialog"><div class="modal-head"><div><span class="detail-eyebrow review-eyebrow">ASSET SURVEY</span><h2 id="importTitle">Import Excel</h2><p class="muted">รองรับ Template ชีต Asset Surveys (.xlsx, .xlsm)</p></div><button type="button" class="icon-button" onclick="closeImportDialog()">×</button></div><div class="import-note">ข้อมูลจะถูกสร้างเป็น <b>Draft</b> และใช้ผู้ที่กำลังเข้าสู่ระบบเป็นผู้สร้างรายการ</div><div class="field"><label>เลือกไฟล์ Excel *</label><asp:FileUpload ID="fileImport" runat="server" accept=".xlsx,.xlsm"/></div><details class="import-mapping"><summary>ดูการจับคู่คอลัมน์</summary><div class="table-wrap"><table><thead><tr><th>คอลัมน์ Excel</th><th>ข้อมูลในระบบ</th></tr></thead><tbody><tr><td>Photo 1 / 2 / 3</td><td>รูปทรัพย์สิน / Serial / รูปอื่น (ยังไม่นำเข้ารูปฝังใน Excel)</td></tr><tr><td>Survey Date</td><td>วันที่สำรวจ</td></tr><tr><td>Asset Name</td><td>ชื่อทรัพย์สิน</td></tr><tr><td>W x L x H</td><td>กว้าง × ยาว × สูง (cm)</td></tr><tr><td>Weight</td><td>น้ำหนัก (kg)</td></tr><tr><td>Category, Department</td><td>ประเภทและแผนกจาก Master Data</td></tr><tr><td>Custodian, Condition</td><td>ผู้ดูแลและสภาพทรัพย์สิน</td></tr><tr><td>Qty, UOM</td><td>จำนวนและหน่วย</td></tr><tr><td>Building, Floor, Room</td><td>สถานที่จาก Master Data</td></tr><tr><td>Brand, Model, Serial Number</td><td>ยี่ห้อ รุ่น และ Serial</td></tr><tr><td>Ownership</td><td>กรรมสิทธิ์</td></tr><tr><td>Received Date, PO No., Estimated Value</td><td>วันที่รับเข้า PO และมูลค่า</td></tr><tr><td>Remark</td><td>หมายเหตุ</td></tr></tbody></table></div></details><div class="modal-actions"><button type="button" class="button outline" onclick="closeImportDialog()">ยกเลิก</button><asp:Button ID="btnImport" runat="server" CssClass="button primary" Text="นำเข้าข้อมูล" OnClick="Import_Click" OnClientClick="return validateImport();"/></div></div></div>
<asp:Panel ID="pnlDetail" runat="server" CssClass="modal-layer" Visible="false"><div class="modal-card review-detail-modal"><div class="modal-head"><div><span class="detail-eyebrow review-eyebrow">ASSET SURVEY</span><h2>รายละเอียดการสำรวจทรัพย์สิน</h2><p class="muted">ข้อมูล รูปภาพ และสถานะ Workflow</p></div><asp:Button ID="btnClose" runat="server" Text="×" CssClass="icon-button" OnClick="Close_Click" CausesValidation="false"/></div><div class="detail-images review-gallery"><asp:Repeater ID="repImages" runat="server"><ItemTemplate><figure><img src='<%# AttachmentUrl(Eval("AttachmentId")) %>' alt='<%# PhotoLabel(Eval("AttachmentType")) %>'/><figcaption><%# PhotoLabel(Eval("AttachmentType")) %></figcaption></figure></ItemTemplate></asp:Repeater></div><asp:Literal ID="litDetail" runat="server"/></div></asp:Panel><script>function openImportDialog(){document.getElementById('importDialog').hidden=false}function closeImportDialog(){document.getElementById('importDialog').hidden=true}function validateImport(){var f=document.getElementById('<%= fileImport.ClientID %>');if(!f.value){f.focus();return false}return true}</script></asp:Content>
