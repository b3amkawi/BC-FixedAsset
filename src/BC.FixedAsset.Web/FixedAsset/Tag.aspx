<%@ Page Title="Asset Tag" Language="C#" AutoEventWireup="true" CodeBehind="Tag.aspx.cs" Inherits="BC.FixedAsset.Web.FixedAsset.AssetTag" %>
<!doctype html><html lang="th"><head runat="server"><meta charset="utf-8"/><meta name="viewport" content="width=device-width"/><title>Asset Tag</title><style>body{font-family:Tahoma;margin:20px}.tag{width:100mm;min-height:60mm;border:1px solid #123d73;border-radius:4mm;padding:5mm;display:grid;grid-template-columns:1fr 30mm;gap:4mm}.logo{color:#123d73;font-weight:900;border-bottom:2px solid #ffcb05;padding-bottom:2mm}.data{display:grid;grid-template-columns:27mm 1fr;font-size:10pt;gap:2mm}.data b{color:#123d73}canvas{width:28mm!important;height:28mm!important}.actions{margin-bottom:15px}@media print{.actions{display:none}body{margin:0}.tag{border-color:#000}}</style></head><body><form runat="server"><div class="actions"><button type="button" onclick="print()">Print / พิมพ์</button></div><div class="tag"><div><div class="logo">BETTER CODE · FIXED ASSET</div><dl class="data"><b>เลขที่ / No.</b><span><asp:Literal ID="litNo" runat="server"/></span><b>ทรัพย์สิน</b><span><asp:Literal ID="litName" runat="server"/></span><b>สถานที่</b><span><asp:Literal ID="litLocation" runat="server"/></span><b>ผู้รับผิดชอบ</b><span><asp:Literal ID="litCustodian" runat="server"/></span></dl></div><canvas id="qr"></canvas></div><asp:HiddenField ID="hidQr" runat="server"/></form><script src="<%= ResolveUrl("~/Scripts/qrcode.bundle.min.js") %>"></script><script>QRCode.toCanvas(document.getElementById('qr'),document.getElementById('<%= hidQr.ClientID %>').value,{margin:1,width:220});</script></body></html>
