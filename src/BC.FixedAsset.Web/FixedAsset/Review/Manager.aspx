<%@ Page Title="Asset Manager Review" Language="C#" MasterPageFile="~/Site.Master" AutoEventWireup="true" CodeBehind="Manager.aspx.cs" Inherits="BC.FixedAsset.Web.FixedAsset.Review.ManagerReview" %><asp:Content ID="Body" ContentPlaceHolderID="MainContent" runat="server"><div class="page-head"><div><h1>Asset Manager Review</h1><p>ตรวจสอบ อนุมัติ หรือ Return พร้อมเหตุผล</p></div></div><asp:Label ID="lblMessage" runat="server" CssClass="message"/><div class="card card-body"><div class="field"><label>เหตุผลสำหรับ Return</label><asp:TextBox ID="txtReason" runat="server" TextMode="MultiLine" Rows="2"/></div></div><section class="card" style="margin-top:14px"><div class="table-wrap"><asp:GridView ID="gridReview" runat="server" AutoGenerateColumns="false" GridLines="None" OnRowCommand="Grid_RowCommand"><Columns><asp:BoundField DataField="SurveyNo" HeaderText="เลขที่"/><asp:BoundField DataField="AssetName" HeaderText="ทรัพย์สิน"/><asp:BoundField DataField="DepartmentName" HeaderText="แผนก"/><asp:BoundField DataField="CreatedByName" HeaderText="ผู้สร้าง"/><asp:TemplateField HeaderText="ดำเนินการ"><ItemTemplate><asp:LinkButton runat="server" CssClass="button small primary" CommandName="ApproveSurvey" CommandArgument='<%# Eval("SurveyId") %>'>Approve</asp:LinkButton> <asp:LinkButton runat="server" CssClass="button small danger" CommandName="ReturnSurvey" CommandArgument='<%# Eval("SurveyId") %>'>Return</asp:LinkButton></ItemTemplate></asp:TemplateField></Columns></asp:GridView></div></section></asp:Content>
