<%@ Page Title="Finance Review" Language="C#" MasterPageFile="~/Site.Master" AutoEventWireup="true" CodeBehind="Finance.aspx.cs" Inherits="BC.FixedAsset.Web.FixedAsset.Review.FinanceReview" %><asp:Content ID="Body" ContentPlaceHolderID="MainContent" runat="server"><div class="page-head"><div><h1>Finance Review</h1><p>อนุมัติขึ้นทะเบียนและสร้างเลข Fixed Asset หรือ Return พร้อมเหตุผล</p></div></div><asp:Label ID="lblMessage" runat="server" CssClass="message"/><div class="card card-body"><div class="field"><label>เหตุผลสำหรับ Return</label><asp:TextBox ID="txtReason" runat="server" TextMode="MultiLine" Rows="2"/></div></div><section class="card" style="margin-top:14px"><div class="table-wrap"><asp:GridView ID="gridReview" runat="server" AutoGenerateColumns="false" GridLines="None" OnRowCommand="Grid_RowCommand"><Columns><asp:BoundField DataField="SurveyNo" HeaderText="เลขที่"/><asp:BoundField DataField="AssetName" HeaderText="ทรัพย์สิน"/><asp:BoundField DataField="PurchaseOrderNo" HeaderText="PO"/><asp:BoundField DataField="EstimatedValue" HeaderText="Estimated Value" DataFormatString="{0:N2}"/><asp:TemplateField HeaderText="ดำเนินการ"><ItemTemplate><asp:LinkButton runat="server" CssClass="button small primary" CommandName="ApproveSurvey" CommandArgument='<%# Eval("SurveyId") %>'>Register</asp:LinkButton> <asp:LinkButton runat="server" CssClass="button small danger" CommandName="ReturnSurvey" CommandArgument='<%# Eval("SurveyId") %>'>Return</asp:LinkButton></ItemTemplate></asp:TemplateField></Columns></asp:GridView></div></section></asp:Content>
