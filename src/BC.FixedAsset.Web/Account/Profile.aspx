<%@ Page Title="My Profile" Language="C#" MasterPageFile="~/Site.Master" AutoEventWireup="true" CodeBehind="Profile.aspx.cs" Inherits="BC.FixedAsset.Web.Account.Profile" %><asp:Content ID="Body" ContentPlaceHolderID="MainContent" runat="server"><div class="page-head"><div><h1>ข้อมูลส่วนตัว / My Profile</h1><p>ข้อมูลติดต่อและความปลอดภัยของบัญชี / Contact details and account security</p></div></div><asp:Panel ID="pnlPasswordRequired" runat="server" CssClass="password-notice" Visible="false">🛡 <span>บัญชีนี้ใช้รหัสผ่านเริ่มต้น กรุณาเปลี่ยนรหัสผ่าน / This account uses a temporary password.</span></asp:Panel><asp:Label ID="lblMessage" runat="server" CssClass="message"/><div class="profile-stack"><section class="card profile-card"><div class="card-body"><div class="profile-avatar"><asp:Literal ID="litInitials" runat="server"/></div><div class="form-grid"><div class="field"><label>User Login</label><asp:TextBox ID="txtUserName" runat="server" ReadOnly="true"/></div><div class="field"><label>Email</label><asp:TextBox ID="txtEmail" runat="server" TextMode="Email"/></div><div class="field"><label>ชื่อจริง / First name</label><asp:TextBox ID="txtFirstName" runat="server"/></div><div class="field"><label>นามสกุล / Last name</label><asp:TextBox ID="txtLastName" runat="server"/></div><div class="field"><label>เบอร์ติดต่อ / Phone</label><asp:TextBox ID="txtPhone" runat="server"/></div><div class="field"><label>ตำแหน่ง / Position</label><asp:TextBox ID="txtPosition" runat="server"/></div><div class="field"><label>ฝ่าย / Division</label><asp:TextBox ID="txtDivision" runat="server" ReadOnly="true"/></div><div class="field"><label>แผนก / Department</label><asp:TextBox ID="txtDepartment" runat="server" ReadOnly="true"/></div><div class="field full"><asp:Button ID="btnSave" runat="server" CssClass="button primary" Text="บันทึก Profile / Save profile" OnClick="Save_Click"/></div></div></div></section><section class="card"><div class="card-head"><h2>เปลี่ยนรหัสผ่าน / Change password</h2></div><div class="card-body"><p class="muted">อย่างน้อย 12 ตัวอักษร พร้อมตัวพิมพ์ใหญ่ ตัวพิมพ์เล็ก ตัวเลข และอักขระพิเศษ</p><div class="form-grid"><div class="field"><label>รหัสผ่านปัจจุบัน</label><asp:TextBox ID="txtCurrentPassword" runat="server" TextMode="Password"/></div><div class="field"><label>รหัสผ่านใหม่</label><asp:TextBox ID="txtNewPassword" runat="server" TextMode="Password"/></div><div class="field"><label>ยืนยันรหัสผ่านใหม่</label><asp:TextBox ID="txtConfirmPassword" runat="server" TextMode="Password"/></div><div class="field full"><asp:Button ID="btnChangePassword" runat="server" CssClass="button primary" Text="เปลี่ยนรหัสผ่าน / Change password" OnClick="ChangePassword_Click"/></div></div></div></section></div></asp:Content>
