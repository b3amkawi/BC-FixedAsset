<%@ Page Title="Application Portal Management" Language="C#" MasterPageFile="~/Site.Master" AutoEventWireup="true" CodeBehind="Applications.aspx.cs" Inherits="BC.FixedAsset.Web.Admin.Applications" %>
<asp:Content ID="Body" ContentPlaceHolderID="MainContent" runat="server"><div class="admin-tabs"><a class="active" href="Applications.aspx">▣ Application Portal</a><a href="Users.aspx">♙ ผู้ใช้และสิทธิ์</a><a href="MasterData.aspx">▤ ข้อมูลกลาง</a><a href="../FixedAsset/Numbering.aspx">⚙ เลขทรัพย์สิน</a></div><div class="page-head"><div><h1>Application Portal Management</h1><p>จัดการ Icon ชื่อ คำอธิบาย Link และสถานะของ Application</p></div><div class="actions"><asp:Button ID="btnNew" runat="server" CssClass="button primary" Text="เพิ่ม Application" OnClick="New_Click"/></div></div><asp:Label ID="lblMessage" runat="server"/><section class="card table-card"><div class="table-wrap"><asp:GridView ID="gridApplications" runat="server" AutoGenerateColumns="false" GridLines="None" OnRowCommand="Grid_RowCommand"><Columns><asp:BoundField DataField="IconText" HeaderText="Icon"/><asp:BoundField DataField="ApplicationCode" HeaderText="Code"/><asp:BoundField DataField="NameTh" HeaderText="ชื่อ Application"/><asp:BoundField DataField="DescriptionTh" HeaderText="คำอธิบาย"/><asp:BoundField DataField="TargetUrl" HeaderText="Link"/><asp:CheckBoxField DataField="IsActive" HeaderText="Active"/><asp:TemplateField><ItemTemplate><asp:LinkButton runat="server" CommandName="EditApplication" CommandArgument='<%# Eval("ApplicationId") %>' Text="แก้ไข"/></ItemTemplate></asp:TemplateField></Columns></asp:GridView></div></section><asp:Panel ID="pnlEditor" runat="server" CssClass="card" style="margin-top:18px" Visible="false"><div class="card-head"><h2>Application Detail</h2></div><div class="card-body form-grid"><asp:HiddenField ID="hidApplicationId" runat="server"/><div class="field"><label>Application Code</label><asp:TextBox ID="txtCode" runat="server" MaxLength="50"/></div><div class="field"><label>Icon / อักษรย่อ</label><asp:TextBox ID="txtIcon" runat="server" MaxLength="20"/></div><div class="field full"><label>Icon Path / HTTPS URL</label><asp:TextBox ID="txtIconPath" runat="server" MaxLength="500"/></div><div class="field"><label>ชื่อภาษาไทย</label><asp:TextBox ID="txtNameTh" runat="server" MaxLength="150"/></div><div class="field"><label>English Name</label><asp:TextBox ID="txtNameEn" runat="server" MaxLength="150"/></div><div class="field full"><label>คำอธิบาย</label><asp:TextBox ID="txtDescriptionTh" runat="server" TextMode="MultiLine" Rows="3" MaxLength="500"/></div><div class="field full"><label>Target URL</label><asp:TextBox ID="txtTargetUrl" runat="server" MaxLength="500"/></div><div class="field"><label>Display Order</label><asp:TextBox ID="txtDisplayOrder" runat="server" TextMode="Number"/></div><div class="field"><label><asp:CheckBox ID="chkActive" runat="server"/> Active</label></div><div class="field full"><asp:Button ID="btnSave" runat="server" CssClass="button primary" Text="บันทึก Application" OnClick="Save_Click"/></div></div></asp:Panel></asp:Content>
